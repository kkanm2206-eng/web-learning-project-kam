บทที่ 8 การสร้างระบบแบบทดสอบและประเมินผลออนไลน์
8.1 ความหมายของแบบทดสอบออนไลน์
แบบทดสอบออนไลน์ (Online Quiz) คือ เครื่องมือที่ใช้วัดความรู้และความเข้าใจของผู้เรียนผ่านระบบเว็บไซต์ โดยผู้เรียนสามารถตอบคำถามและส่งคำตอบผ่านเว็บเบราว์เซอร์ได้

แบบทดสอบออนไลน์ช่วยลดขั้นตอนการตรวจคำตอบ และสามารถนำผลคะแนนมาใช้ประเมินความเข้าใจของผู้เรียนได้
8.2 ประเภทของแบบทดสอบ
1. แบบปรนัย เป็นคำถามที่มีตัวเลือกให้เลือกตอบ
2. แบบถูกหรือผิด เป็นคำถามที่ให้ผู้เรียนพิจารณาว่าข้อความถูกต้องหรือไม่
3. แบบเติมคำ เป็นคำถามที่ให้ผู้เรียนพิมพ์คำตอบลงในช่องว่าง
4. แบบจับคู่ เป็นคำถามที่ให้ผู้เรียนจับคู่ข้อความที่มีความสัมพันธ์กัน
5. แบบอัตนัย เป็นคำถามที่ให้ผู้เรียนเขียนคำตอบด้วยตนเอง
8.3 องค์ประกอบของระบบแบบทดสอบ
ระบบแบบทดสอบออนไลน์ควรประกอบด้วย
- ชื่อแบบทดสอบ
- คำชี้แจง
- จำนวนข้อสอบ
- รายการคำถาม
- ตัวเลือกคำตอบ
- ปุ่มส่งคำตอบ
- ระบบตรวจสอบคำตอบ
- ระบบคำนวณคะแนน
- หน้าแสดงผลคะแนน
8.4 การสร้างแบบทดสอบด้วย HTML
HTML สามารถสร้างช่องตัวเลือกสำหรับให้ผู้เรียนเลือกคำตอบได้ โดยใช้แท็ก <input> และกำหนดประเภทเป็น radio

ตัวอย่าง
<h3>HTML ใช้สำหรับอะไร?</h3>

<label>
    <input type="radio" name="answer" value="a">
    ตกแต่งเว็บไซต์
</label>

<label>
    <input type="radio" name="answer" value="b">
    สร้างโครงสร้างเว็บไซต์
</label>

<label>
    <input type="radio" name="answer" value="c">
    จัดเก็บฐานข้อมูล
</label>


8.5 การตรวจสอบคำตอบด้วย JavaScript
JavaScript สามารถนำคำตอบของผู้เรียนมาตรวจสอบกับคำตอบที่ถูกต้องได้
function checkAnswer() {
    const answer = document.querySelector(
        'input[name="answer"]:checked'
    );

    if (!answer) {
        alert("กรุณาเลือกคำตอบ");
        return;
    }

    if (answer.value === "b") {
        alert("ถูกต้อง!");
    } else {
        alert("ยังไม่ถูกต้อง ลองศึกษาเนื้อหาอีกครั้ง");
    }
}


8.6 การคำนวณคะแนน
ระบบสามารถกำหนดคะแนนของแต่ละข้อได้ เช่น ตอบถูก 1 คะแนน ตอบผิด 0 คะแนน หากมีข้อสอบทั้งหมด 10 ข้อ ผู้เรียนจะได้รับคะแนนเต็ม 10 คะแนน

สูตรการคำนวณร้อยละของคะแนน
\[
\text{ร้อยละ} =
\frac{\text{คะแนนที่ได้}}{\text{คะแนนเต็ม}}
\times 100
\]

ตัวอย่าง หากได้ 8 คะแนนจากคะแนนเต็ม 10 คะแนน
\[
\frac{8}{10}\times100=80\%
\]

8.7 การสร้างแบบทดสอบก่อนเรียนและหลังเรียน
แบบทดสอบก่อนเรียน (Pre-test) ใช้ตรวจสอบความรู้พื้นฐานของผู้เรียนก่อนศึกษาเนื้อหา ส่วนแบบทดสอบหลังเรียน (Post-test) ใช้ตรวจสอบความรู้หลังจากเรียนจบแล้ว

การเปรียบเทียบคะแนนทั้งสองครั้งช่วยให้เห็นแนวโน้มการพัฒนาความรู้ของผู้เรียน
8.8 สรุปบทเรียน
ระบบแบบทดสอบออนไลน์เป็นเครื่องมือสำคัญในการประเมินผลการเรียนรู้ สามารถสร้างได้ด้วย HTML สำหรับแสดงคำถาม CSS สำหรับตกแต่ง และ JavaScript สำหรับตรวจคำตอบและคำนวณคะแนน

